@{
    ViewData["Title"] = "Hệ thống quản lý đồ án tốt nghiệp";
}

<style>
    /* Tạo lớp phủ cho toàn bộ trang */
    .homepage-wrapper {
        min-height: calc(100vh - 200px);
        background-image: url('/images/truong_bach_khoa.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        position: relative;
        padding: 40px 0;
    }

        /* Lớp phủ gradient từ trên xuống dưới */
        .homepage-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient( 180deg, rgba(224, 247, 250, 0.92) 0%, rgba(209, 242, 255, 0.88) 50%, rgba(224, 247, 250, 0.92) 100% );
            z-index: 1;
        }

        /* Đảm bảo content hiển thị trên lớp phủ */
        .homepage-wrapper > .container {
            position: relative;
            z-index: 2;
        }

    /* Banner chính - làm nổi bật hơn */
    .homepage-banner {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(240, 253, 255, 0.98));
        border-radius: 25px;
        padding: 50px 40px !important;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        border: 2px solid rgba(13, 27, 61, 0.1);
        backdrop-filter: blur(15px);
        margin-bottom: 50px;
    }

        .homepage-banner h2 {
            font-weight: 600;
            color: #0d1b3d;
            margin-bottom: 20px;
            text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.8);
        }

        .homepage-banner p {
            font-size: 18px;
            color: #1a3a6d;
            font-weight: 500;
        }

    /* Các card tính năng */
    .feature-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(245, 254, 255, 0.95));
        border-radius: 20px;
        padding: 35px 30px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        border: 2px solid rgba(13, 27, 61, 0.08);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
        height: 100%;
    }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(13, 27, 61, 0.2);
            border-color: rgba(13, 27, 61, 0.2);
        }

        .feature-card h4 {
            color: #0d1b3d;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 22px;
        }

        .feature-card p {
            color: #1a3a6d;
            font-size: 16px;
            line-height: 1.6;
        }

    /* Icon cho các card */
    .feature-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #0d1b3d, #1a3a6d);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        box-shadow: 0 5px 15px rgba(13, 27, 61, 0.3);
    }

        .feature-icon i {
            font-size: 32px;
            color: white;
        }

    /* Tiêu đề section */
    .section-title {
        text-align: center;
        margin-bottom: 40px;
        color: #0d1b3d;
        font-weight: 700;
        font-size: 36px;
        text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.8);
    }
</style>

<div class="homepage-wrapper">
    <div class="container">

        <!-- Banner chính -->
        <div class="homepage-banner">
            <h2 class="display-4">CNPM: Website quản lí đồ án tốt nghiệp</h2>
            <p class="mt-3">
                Nền tảng hỗ trợ sinh viên và giảng viên quản lý đề tài, theo dõi tiến độ & chấm điểm.
            </p>
        </div>

        <!-- Tính năng -->
        <h2 class="section-title">Các chức năng chính</h2>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <h4>Quản lý đề tài</h4>
                    <p>Sinh viên xem danh sách đề tài, đăng ký & theo dõi trạng thái phê duyệt.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4>Theo dõi tiến độ</h4>
                    <p>Upload báo cáo tiến độ, nhận phản hồi từ giảng viên, lưu lịch sử làm việc.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="bi bi-award"></i>
                    </div>
                    <h4>Chấm điểm</h4>
                    <p>Giảng viên theo dõi tiến độ và chấm điểm đồ án của sinh viên.</p>
                </div>
            </div>
        </div>

    </div>
</div>